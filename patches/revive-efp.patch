+bool ovrHmdStruct::CacheMatches(const EFP_HmdCache& cache) const
+{
+	XrInstanceProperties props = XR_TYPE(INSTANCE_PROPERTIES);
+	if (XR_FAILED(xrGetInstanceProperties(Instance, &props)) || strcmp(cache.Runtime, props.runtimeName))
+	{
+		EFP_Log("hmd cache: made with runtime '%s', ignored", cache.Runtime);
+		return false;
+	}
+	for (int i = 0; i < ovrEye_Count; i++)
+	{
+		if (cache.Width[i] != ViewConfigs[i].recommendedImageRectWidth || cache.Height[i] != ViewConfigs[i].recommendedImageRectHeight)
+		{
+			EFP_Log("hmd cache: made for %ux%u per eye, the headset now recommends %ux%u, ignored",
+				cache.Width[i], cache.Height[i], ViewConfigs[i].recommendedImageRectWidth, ViewConfigs[i].recommendedImageRectHeight);
+			return false;
+		}
+	}
+	return true;
+}
+
+void ovrHmdStruct::SaveHmdCache(const XrView views[ovrEye_Count])
+{
+	EFP_HmdCache cache = {};
+	XrInstanceProperties props = XR_TYPE(INSTANCE_PROPERTIES);
+	xrGetInstanceProperties(Instance, &props);
+	strcpy_s(cache.Runtime, props.runtimeName);
+	for (int i = 0; i < ovrEye_Count; i++)
+	{
+		const XrView& view = views ? views[i] : ViewPoses[i];
+		cache.Width[i] = ViewConfigs[i].recommendedImageRectWidth;
+		cache.Height[i] = ViewConfigs[i].recommendedImageRectHeight;
+		cache.Fov[i] = view.fov;
+		cache.Pose[i] = view.pose;
+	}
+	cache.Bounds = bounds;
+	EFP_SaveHmdCache(cache);
+	HmdCacheValid = true;
+}
